{
  "expo": {
    "name": "AdiV",
    "slug": "adiv-mobile",
    "version": "1.3.7",
    "orientation": "portrait",
    "icon": "./assets/images/adiv-icon-safe.png",
    "scheme": "adiv",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.damascus.adiv",
      "versionCode": 17,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f8fafc",
        "foregroundImage": "./assets/images/adiv-icon-safe.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.33.1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fafc",
          "image": "./assets/images/adiv-icon-safe.png",
          "imageWidth": 148
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/images/adiv-location-notification.png"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "AdiV uses photos you choose as ride backgrounds.",
          "savePhotosPermission": "AdiV saves ride activity images to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "AdiV uses your photos when you attach service records.",
          "cameraPermission": "AdiV uses your camera to photograph completed service."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adiv-icon.png",
          "largeIcon": "./assets/images/ADiV-shesh.png",
          "color": "#e62025",
          "defaultChannel": "maintenance-reminders"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "AdivWidget",
              "label": "ADiV",
              "description": "Odometer and the next service your bike needs, at a glance.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2
            }
          ]
        }
      ],
      [
        "expo-sqlite",
        {
          "android": {
            "enableFTS": true
          }
        }
      ],
      "./plugins/with-expo-location-next-consumers"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a6cae218-d886-4ef9-9e7f-ae2a24a93f55"
      }
    },
    "owner": "star2256"
  }
}
