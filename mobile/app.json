{
  "expo": {
    "name": "AdiV",
    "slug": "adiv-mobile",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/adiv-icon-safe.png",
    "scheme": "adiv",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.damascus.adiv",
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f8fafc",
        "foregroundImage": "./assets/images/adiv-icon-safe.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fafc",
          "image": "./assets/images/adiv-icon-safe.png",
          "imageWidth": 148
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "AdiV uses your photos when you attach service records.",
          "cameraPermission": "AdiV uses your camera to photograph completed service."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adiv-icon.png",
          "color": "#e62025",
          "defaultChannel": "maintenance-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a6cae218-d886-4ef9-9e7f-ae2a24a93f55"
      }
    },
    "owner": "star2256"
  }
}
